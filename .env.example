# Copy to .env.local and fill in. Never commit real values.

# Public production URL (enables canonical links, sitemap URL and absolute OG URLs).
NEXT_PUBLIC_SITE_URL=

# Contact form delivery (Resend). Without these, development logs enquiries
# and reports "not delivered"; production reports that the form is not connected.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
